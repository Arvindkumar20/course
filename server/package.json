{
  "name": "cctv",
  "version": "1.0.0",
  "description": "A secure and scalable CCTV Monitoring Dashboard built to provide real-time surveillance management, live camera monitoring, and role-based access control for organizations requiring centralized security operations.",
  "main": "ecosystem.config.js",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green  \"npm:dev:server\" \"npm:dev:client\"",
    "i": "concurrently -k -n server,client -c blue,green  \"npm:dev:server\" \"npm:dev:client\"",
    "i:server": "cd server && npm i",
    "i:client": "cd client && npm i",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "prod": "pm2 start ecosystem.config.js",
    "prod:reload": "pm2 reload all",
    "prod:logs": "pm2 logs"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "author": "",
  "license": "ISC"
}



